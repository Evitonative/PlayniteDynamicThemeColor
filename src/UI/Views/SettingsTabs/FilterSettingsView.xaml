<UserControl x:Class="DynamicThemeColor.UI.Views.SettingsTabs.FilterSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:c="clr-namespace:DynamicThemeColor.UI.Components"
             xmlns:rl="clr-namespace:DynamicThemeColor.UI.Components.RankableList"
             xmlns:vm="clr-namespace:DynamicThemeColor.UI.ViewModels.SettingsTabs"
             mc:Ignorable="d" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance Type=vm:FilterSettingsViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/DynamicThemeColor;component/src/UI/Resources/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:FilterItemViewModel}">
                <TextBlock Text="{Binding DisplayName}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}"/>
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="{StaticResource Layout.Spacing.Root}">
            <GroupBox Margin="{StaticResource Layout.Spacing.Section}">
                <GroupBox.Header>
                    <Grid Width="{Binding ActualWidth, ElementName=GameListBody}"
                          Margin="{StaticResource Layout.Padding.GroupBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCDTCFiltersGameFilters}"
                                   VerticalAlignment="Center" />
                        <c:HelpIcon Grid.Column="1" VerticalAlignment="Center"
                                    HelpToolTip="{DynamicResource LOCDTCFiltersGameFiltersHint}" />

                        <rl:RankableToolbarHeader
                            Grid.Column="2" VerticalAlignment="Center"
                            Margin="{StaticResource Layout.Spacing.Between}"
                            ListBody="{Binding ElementName=GameListBody}"
                            EditingEnabled="True" RemovingEnabled="True"
                            AddCommand="{Binding AddGameFilterCommand}"/>
                    </Grid>
                </GroupBox.Header>

                <StackPanel Margin="{StaticResource Layout.Padding.GroupBox}">
                    <rl:RankableListBody ItemsSource="{Binding GameFilters}" x:Name="GameListBody" />
                </StackPanel>
            </GroupBox>


            <GroupBox Margin="{StaticResource Layout.Spacing.Section}">
                <GroupBox.Header>
                    <Grid Width="{Binding ActualWidth, ElementName=SeedListBody}"
                          Margin="{StaticResource Layout.Padding.GroupBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCDTCFiltersSeedFilters}"
                                   VerticalAlignment="Center" />
                        <c:HelpIcon Grid.Column="1" VerticalAlignment="Center"
                                    HelpToolTip="{DynamicResource LOCDTCFiltersSeedFiltersHint}" />

                        <rl:RankableToolbarHeader
                            Grid.Column="2" VerticalAlignment="Center"
                            Margin="{StaticResource Layout.Spacing.Between}"
                            ListBody="{Binding ElementName=SeedListBody}"
                            EditingEnabled="True" RemovingEnabled="True"
                            AddCommand="{Binding AddSeedFilterCommand}"/>
                    </Grid>
                </GroupBox.Header>

                <StackPanel Margin="{StaticResource Layout.Padding.GroupBox}">
                    <rl:RankableListBody ItemsSource="{Binding SeedFilters}" x:Name="SeedListBody" />
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="{StaticResource Layout.Spacing.Section}">
                <GroupBox.Header>
                    <Grid Width="{Binding ActualWidth, ElementName=PaletteListBody}"
                          Margin="{StaticResource Layout.Padding.GroupBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCDTCFiltersPaletteFilters}"
                                   VerticalAlignment="Center" />

                        <c:HelpIcon Grid.Column="1" VerticalAlignment="Center"
                                    HelpToolTip="{DynamicResource LOCDTCFiltersPaletteFiltersHint}" />

                        <rl:RankableToolbarHeader
                            Grid.Column="2" VerticalAlignment="Center"
                            Margin="{StaticResource Layout.Spacing.Between}"
                            ListBody="{Binding ElementName=PaletteListBody}"
                            EditingEnabled="True" RemovingEnabled="True"
                            AddCommand="{Binding AddPaletteFilterCommand}"/>
                    </Grid>
                </GroupBox.Header>

                <StackPanel Margin="{StaticResource Layout.Padding.GroupBox}">
                    <rl:RankableListBody ItemsSource="{Binding PaletteFilters}" x:Name="PaletteListBody" />
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="{StaticResource Layout.Spacing.Section}">
                <GroupBox.Header>
                    <Grid Width="{Binding ActualWidth, ElementName=BrushesListBody}"
                          Margin="{StaticResource Layout.Padding.GroupBox}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{DynamicResource LOCDTCFiltersBrushFilters}"
                                   VerticalAlignment="Center" />

                        <c:HelpIcon Grid.Column="1" VerticalAlignment="Center"
                                    HelpToolTip="{DynamicResource LOCDTCFiltersBrushFiltersHint}" />

                        <rl:RankableToolbarHeader
                            Grid.Column="2" VerticalAlignment="Center"
                            Margin="{StaticResource Layout.Spacing.Between}"
                            ListBody="{Binding ElementName=BrushesListBody}"
                            EditingEnabled="True" RemovingEnabled="True"
                            AddCommand="{Binding AddBrushFilterCommand}"/>
                    </Grid>
                </GroupBox.Header>

                <StackPanel Margin="{StaticResource Layout.Padding.GroupBox}">
                    <rl:RankableListBody ItemsSource="{Binding BrushFilters}" x:Name="BrushesListBody"/>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
