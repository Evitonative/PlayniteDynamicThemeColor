<UserControl x:Class="DynamicThemeColor.UI.Views.AddFilterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DynamicThemeColor.UI.Views"
             xmlns:model="clr-namespace:DynamicThemeColor"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="550"
             d:DataContext="{d:DesignInstance Type=views:AddFilterViewModel, IsDesignTimeCreatable=False}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/DynamicThemeColor;component/src/UI/Resources/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="{StaticResource Layout.Spacing.Root}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Margin="{StaticResource Layout.Spacing.Section}">
            <StackPanel>
                <TextBlock Text="{Binding DescriptionMessage}"
                           Foreground="{DynamicResource TextBrush}"
                           TextWrapping="Wrap" />
                <ListView ItemsSource="{Binding Candidates}"
                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                          Background="Transparent"
                          BorderBrush="{DynamicResource PanelSeparatorBrush}"
                          BorderThickness="{DynamicResource ControlBorderThickness}"
                          HorizontalContentAlignment="Stretch"
                          Margin="{StaticResource Layout.Spacing.Expander}">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="{DynamicResource LOCDTCFilterSelectColumnName}" Width="250">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type model:FilterDescriptor}">
                                        <TextBlock Text="{Binding Name}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource LOCDTCGenericSelect}"
                    IsDefault="True"
                    Width="80"
                    Command="{Binding SelectCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />

            <Button Content="{DynamicResource LOCDTCGenericCancel}"
                    IsCancel="True"
                    Margin="{StaticResource Layout.Spacing.Between}"
                    Width="80" />
        </StackPanel>
    </Grid>
</UserControl>
