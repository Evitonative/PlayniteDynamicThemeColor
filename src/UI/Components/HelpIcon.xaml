<UserControl x:Class="DynamicThemeColor.UI.Components.HelpIcon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootHelpIcon">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DynamicThemeColor;component/src/UI/Resources/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <TextBlock Text="ⓘ"
               ToolTip="{Binding HelpToolTip, ElementName=RootHelpIcon}"
               Foreground="{DynamicResource TextBrushDarker}"
               Cursor="Help"
               VerticalAlignment="Center"
               Margin="{StaticResource Layout.Margin.HelpIcon}" />
</UserControl>
