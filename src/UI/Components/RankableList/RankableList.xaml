<rl:RankableComponentBase x:Class="DynamicThemeColor.UI.Components.RankableList.RankableList"
                                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                     xmlns:rl="clr-namespace:DynamicThemeColor.UI.Components.RankableList"
                                     x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/DynamicThemeColor;component/src/UI/Resources/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <rl:RankableToolbarHeader
            Grid.Row="0"
            ListBody="{Binding ElementName=ListBody}"
            AddCommand="{Binding AddCommand, ElementName=Root}"
            AddingEnabledOverride="{Binding AddingEnabledOverride, ElementName=Root}"
            RemovingEnabled="{Binding RemovingEnabled, ElementName=Root}"
            EditingEnabled="{Binding EditingEnabled, ElementName=Root}"
            ReorderingEnabled="{Binding ReorderingEnabled, ElementName=Root}"
            Margin="{StaticResource Layout.Spacing.TableHeader}"/>

        <rl:RankableListBody Grid.Row="1" x:Name="ListBody"
                                       ItemsSource="{Binding ItemsSource, ElementName=Root}"
                                       SelectedItem="{Binding SelectedItem, ElementName=Root, Mode=TwoWay}"/>
    </Grid>
</rl:RankableComponentBase>
