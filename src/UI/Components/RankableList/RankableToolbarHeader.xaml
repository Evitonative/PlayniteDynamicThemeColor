<rl:RankableComponentBase x:Class="DynamicThemeColor.UI.Components.RankableList.RankableToolbarHeader"
                                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                    xmlns:rl="clr-namespace:DynamicThemeColor.UI.Components.RankableList"
                                    x:Name="Root">
    <rl:RankableComponentBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="pack://application:,,,/DynamicThemeColor;component/src/UI/Resources/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="36" />
            </Style>
        </ResourceDictionary>
    </rl:RankableComponentBase.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Button Grid.Column="0" Content="+"
                Style="{StaticResource ToolbarButton}"
                ToolTip="{DynamicResource LOCDTCGenericAddItem}"
                Margin="{StaticResource Layout.Spacing.BetweenTrailing}"
                Visibility="{Binding AddingEnabled, ElementName=Root, Converter={StaticResource BoolToVis}}"
                Command="{Binding AddCommand, ElementName=Root}">
        </Button>

        <Button Grid.Column="1" Content="-"
                Style="{StaticResource ToolbarButton}"
                ToolTip="{DynamicResource LOCDTCGenericRemoveItem}"
                Foreground="{DynamicResource WarningBrush}"
                Margin="{StaticResource Layout.Spacing.BetweenTrailing}"
                Visibility="{Binding RemovingEnabled, ElementName=Root, Converter={StaticResource BoolToVis}}"
                Command="{Binding RemoveCommand, ElementName=Root}" />

        <Button Grid.Column="2" Content="🖉"
                Style="{StaticResource ToolbarButton}"
                ToolTip="{DynamicResource LOCDTCGenericEditItem}"
                Margin="{StaticResource Layout.Spacing.BetweenTrailing}"
                Visibility="{Binding EditingEnabled, ElementName=Root, Converter={StaticResource BoolToVis}}"
                Command="{Binding EditCommand, ElementName=Root}" />

        <Button Grid.Column="4" Content="▴"
                Style="{StaticResource ToolbarButton}"
                ToolTip="{DynamicResource LOCDTCAssetPriorityMoveUpHint}"
                Margin="{StaticResource Layout.Spacing.BetweenTrailing}"
                Visibility="{Binding ReorderingEnabled, ElementName=Root, Converter={StaticResource BoolToVis}}"
                Command="{Binding MoveUpCommand, ElementName=Root}" />

        <Button Grid.Column="5" Content="▾"
                Style="{StaticResource ToolbarButton}"
                ToolTip="{DynamicResource LOCDTCAssetPriorityMoveDownHint}"
                Margin="{StaticResource Layout.Spacing.BetweenTrailing}"
                Visibility="{Binding ReorderingEnabled, ElementName=Root, Converter={StaticResource BoolToVis}}"
                Command="{Binding MoveDownCommand, ElementName=Root}" />
    </Grid>
</rl:RankableComponentBase>
