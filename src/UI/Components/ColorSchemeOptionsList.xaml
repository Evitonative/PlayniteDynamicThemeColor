<UserControl x:Class="DynamicThemeColor.UI.Components.ColorSchemeOptionsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <GroupBox Margin="0,0,0,10">
        <GroupBox.Header>
            <StackPanel Orientation="Horizontal"
                        Margin="10,8,15,5" >
                <Border Padding="6,2"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#FF444444" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="BuiltIn">
                                    <Setter Property="Background" Value="#FF2196F3" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="Theme">
                                    <Setter Property="Background" Value="#FF9C27B0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="Custom">
                                    <Setter Property="Background" Value="#FF4CAF50" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="SemiBold" >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Built-in" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="BuiltIn">
                                        <Setter Property="Text" Value="{DynamicResource LOCDTCSchemeSourceBuiltIn}" />
                                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="Theme">
                                        <Setter Property="Text" Value="{DynamicResource LOCDTCSchemeSourceTheme}" />
                                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="Custom">
                                        <Setter Property="Text" Value="{DynamicResource LOCDTCSchemeSourceCustom}" />
                                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                           VerticalAlignment="Center"
                           Margin="10,0,0,0" />
            </StackPanel>
        </GroupBox.Header>

        <StackPanel Margin="10,8,5,5">
            <ItemsControl ItemsSource="{Binding Options, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Label}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Margin="0,0,0,8" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="FallbackText"
                       Text="{DynamicResource LOCDTCSchemeNoOptions}"
                       Foreground="{DynamicResource TextBrushDarker}"
                       Margin="0,0,0,15"
                       Visibility="Collapsed">
            </TextBlock>
        </StackPanel>
    </GroupBox>
</UserControl>

