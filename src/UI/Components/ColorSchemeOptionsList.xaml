<UserControl x:Class="DynamicThemeColor.UI.Components.ColorSchemeOptionsList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/DynamicThemeColor;component/src/UI/Resources/SharedResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <GroupBox Margin="0,0,0,10">
        <GroupBox.Header>
            <StackPanel Orientation="Horizontal"
                        Margin="{StaticResource Layout.Padding.Header}" >
                <Border Padding="{StaticResource Layout.Padding.Badge}"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Brush.Badge.Default.Background}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="BuiltIn">
                                    <Setter Property="Background" Value="{StaticResource Brush.Badge.BuiltIn.Background}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="Theme">
                                    <Setter Property="Background" Value="{StaticResource Brush.Badge.Theme.Background}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="Custom">
                                    <Setter Property="Background" Value="{StaticResource Brush.Badge.Custom.Background}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <TextBlock FontSize="{DynamicResource FontSizeSmall}"
                               FontWeight="SemiBold" >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource LOCDTCSchemeSourceBuiltIn}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Badge.Default.Foreground}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="BuiltIn">
                                        <Setter Property="Text" Value="{DynamicResource LOCDTCSchemeSourceBuiltIn}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Badge.BuiltIn.Foreground}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="Theme">
                                        <Setter Property="Text" Value="{DynamicResource LOCDTCSchemeSourceTheme}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Badge.Theme.Foreground}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ColorScheme.SchemeSource, ElementName=Root}" Value="Custom">
                                        <Setter Property="Text" Value="{DynamicResource LOCDTCSchemeSourceCustom}" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Badge.Custom.Foreground}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <TextBlock Text="{Binding DisplayName, ElementName=Root}"
                           VerticalAlignment="Center"
                           Margin="{StaticResource Layout.Margin.HeaderTitle}"/>
            </StackPanel>
        </GroupBox.Header>

        <StackPanel Margin="{StaticResource Layout.Padding.GroupBox}">
            <ItemsControl ItemsSource="{Binding Options, ElementName=Root}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding Label}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  Margin="{StaticResource Layout.Spacing.Item}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock x:Name="FallbackText"
                       Text="{DynamicResource LOCDTCSchemeNoOptions}"
                       Foreground="{DynamicResource TextBrushDarker}"
                       Margin="{StaticResource Layout.Spacing.Section}"
                       Visibility="Collapsed">
            </TextBlock>
        </StackPanel>
    </GroupBox>
</UserControl>

