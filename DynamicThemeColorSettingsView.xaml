<UserControl x:Class="DynamicThemeColor.DynamicThemeColorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            
            <!-- View Targets -->
            <TextBlock Text="{DynamicResource LOCDynamicThemeColorViewsHeader}" FontWeight="Bold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,10" />
            <StackPanel Margin="10,0,0,20">
                <CheckBox IsChecked="{Binding Settings.ApplyInDetailsView}" Margin="0,0,0,5">
                    <TextBlock Text="{DynamicResource LOCDynamicThemeColorApplyDetails}" />
                </CheckBox>
                <CheckBox IsChecked="{Binding Settings.ApplyInGridView}" Margin="0,0,0,5">
                    <TextBlock Text="{DynamicResource LOCDynamicThemeColorApplyGrid}" />
                </CheckBox>
                <CheckBox IsChecked="{Binding Settings.ApplyInListView}" Margin="0,0,0,5">
                    <TextBlock Text="{DynamicResource LOCDynamicThemeColorApplyList}" />
                </CheckBox>
            </StackPanel>
            
            <!-- Color Generation -->
            <TextBlock Text="{DynamicResource LOCDynamicThemeColorGenerationHeader}" FontWeight="Bold" Foreground="{DynamicResource TextBrushDarker}" Margin="0,0,0,10" />
            
            <Grid Margin="10,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition MinHeight="32" Height="Auto" />
                    <RowDefinition MinHeight="32" Height="Auto" />
                    <RowDefinition MinHeight="32" Height="Auto" />
                    <RowDefinition MinHeight="32" Height="Auto" />
                    <RowDefinition MinHeight="32" Height="Auto" />
                    <RowDefinition MinHeight="32" Height="Auto" />
                    <RowDefinition MinHeight="32" Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Palette Style -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LOCDynamicThemeColorPaletteStyle}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableStyles}" SelectedItem="{Binding Settings.PaletteStyle}" Margin="0,0,0,10" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorPaletteStyleTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,10" />

                <!-- Prefer Cover Art -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource LOCDynamicThemeColorPreferCover}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding Settings.PreferCoverArt}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorPreferCoverTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,10" />

                <!-- Selection Range-->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource LOCDynamicThemeColorSelectionRange}" VerticalAlignment="Center" Margin="0,0,0,10" />

                <Grid Grid.Row="2" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
    
                    <Slider Grid.Column="0" 
                            Minimum="1" 
                            Maximum="5" 
                            TickFrequency="1" 
                            IsSnapToTickEnabled="True" 
                            Value="{Binding Settings.ColorSelectionRange}" 
                            VerticalAlignment="Center" 
                            Margin="0,0,10,0" />
            
                    <TextBlock Grid.Column="1" 
                               Text="{Binding Settings.ColorSelectionRange}" 
                               VerticalAlignment="Center" 
                               MinWidth="20" 
                               TextAlignment="Right" />
                </Grid>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorSelectionRangeTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,10" />
                
                <!-- Fallback Color Hex -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource LOCDynamicThemeColorFallbackHex}" VerticalAlignment="Center" Margin="0,0,0,10" />
                
                <Grid Grid.Row="3" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
    
                    <TextBox Grid.Column="0" Text="{Binding Settings.DefaultSeedColorHex, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,10,0" />
    
                    <Button Grid.Column="1" Command="{Binding PickColorCommand}" Padding="2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Rectangle Width="22" Height="22" RadiusX="4" RadiusY="4" 
                                   Stroke="{DynamicResource PanelSeparatorBrush}" StrokeThickness="1"
                                   Fill="{Binding Settings.DefaultSeedColorHex}" />
                    </Button>
                </Grid>
            
                <TextBlock Grid.Row="3" Grid.Column="2" Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorFallbackHexTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,10" />
                
                <!-- Use Seed Color for Glyphs -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource LOCDynamicThemeColorUseSeedGlyph}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding Settings.UseSeedColorForGlyph}" VerticalAlignment="Center" Margin="0,0,0,10" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorUseSeedGlyphTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,0" />
                
                <!-- Saturation -->
                <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource LOCDynamicThemeColorSaturation}" VerticalAlignment="Center" Margin="0,0,0,10" />

                <Grid Grid.Row="5" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
    
                    <Slider Grid.Column="0" 
                            Minimum="-1" 
                            Maximum="4" 
                            TickFrequency="0.01" 
                            IsSnapToTickEnabled="True" 
                            Value="{Binding Settings.SaturationSlider}" 
                            VerticalAlignment="Center" 
                            Margin="0,0,10,0" />
            
                    <TextBlock Grid.Column="1" 
                               Text="{Binding Settings.SaturationSlider, StringFormat={}{0:F2}}" 
                               VerticalAlignment="Center" 
                               MinWidth="20" 
                               TextAlignment="Right" />
                </Grid>

                <TextBlock Grid.Row="5" Grid.Column="2" Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorSaturationTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,10" />

                <!-- Lightness -->
                <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource LOCDynamicThemeColorLightness}" VerticalAlignment="Center" Margin="0,0,0,10" />

                <Grid Grid.Row="6" Grid.Column="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
    
                    <Slider Grid.Column="0" 
                            Minimum="-1" 
                            Maximum="1" 
                            TickFrequency="0.01" 
                            IsSnapToTickEnabled="True" 
                            Value="{Binding Settings.LightnessSlider}" 
                            VerticalAlignment="Center" 
                            Margin="0,0,10,0" />
            
                    <TextBlock Grid.Column="1" 
                               Text="{Binding Settings.LightnessSlider, StringFormat={}{0:F2}}" 
                               VerticalAlignment="Center" 
                               MinWidth="20" 
                               TextAlignment="Right" />
                </Grid>

                <TextBlock Grid.Row="6" Grid.Column="2" Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorLightnessTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,10" />
            </Grid>
            
            <!-- Theme Specific Settings -->
            <Expander Header="{DynamicResource LOCDynamicThemeColorThemeSpecificHeader}" IsExpanded="False" Margin="0,15,0,0">
                <StackPanel Margin="10,10,0,0">
                    
                    <!-- Harmony Section -->
                    <TextBlock Text="Harmony" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextBrushDarker}" />
                    
                    <Grid Margin="10,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="32" Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Panel Override Toggle -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LOCDynamicThemeColorHarmonyDetailsPanel}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Settings.EnableHarmonyDetailsPanelBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorHarmonyDetailsPanelTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>

                </StackPanel>
            </Expander>
            
            
            <!-- Advanced Settings -->
            <Expander Header="{DynamicResource LOCDynamicThemeColorAdvancedHeader}" IsExpanded="False">
                <StackPanel Margin="10,10,0,0">
                    <Grid Margin="10,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition MinHeight="32" Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Always Contrast Improvements -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource LOCDynamicThemeColorContrastImprovementsAlways}" VerticalAlignment="Center" />
                        <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding Settings.AlwaysEnabledContrastImprovements}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorContrastImprovementsAlwaysTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                    
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="{DynamicResource LOCDynamicThemeColorClearCacheBtn}" Command="{Binding ClearCacheCommand}" Padding="15,5" />
                        <TextBlock Text="ⓘ" ToolTip="{DynamicResource LOCDynamicThemeColorClearCacheTooltip}" Foreground="{DynamicResource TextBrushDarker}" Cursor="Help" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>